APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Generate: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Dashboard origin: used for CORS and for links in emails
DASHBOARD_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API (dashboard, landing)
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omnest
DB_USERNAME=root
DB_PASSWORD=

# log = write emails to the log (local dev), resend = send via Resend
MAIL_DRIVER=log
MAIL_FROM="Omnest <hello@omnest.app>"
RESEND_API_KEY=

LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log
